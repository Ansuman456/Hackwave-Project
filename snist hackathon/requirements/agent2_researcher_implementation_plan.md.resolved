  contradictions: z.array(ContradictionSchema)
});

export const CONTRADICTION_DETECTOR_SYSTEM_PROMPT = `
You are the Contradiction Detector node of Agent 2 (Researcher) in HackForge.

INPUT:
Extracted facts from multiple sources for candidate entity: "{{CANDIDATE_NAME}}".

OBJECTIVE:
Compare facts extracted across sources (e.g. Source A says "Works offline", Source B says "Requires continuous internet connection").
If conflicting facts exist, construct a Contradiction object identifying the field, conflicting values, and source IDs. DO NOT silently resolve contradictions or guess.

OUTPUT REQUIREMENTS:
Return valid JSON matching ContradictionOutputSchema.
`;
```

